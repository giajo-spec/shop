# ─── Domaine ────────────────────────────────────────────────────────────────
# URL publique du site, sans barre oblique finale. Sert aux URL canoniques,
# au sitemap, à l'Open Graph et aux données structurées.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─── Indexation ─────────────────────────────────────────────────────────────
# false (défaut) : noindex sur toutes les pages + robots.txt bloquant.
# Passer à true UNIQUEMENT au lancement officiel.
SITE_INDEXABLE=false

# ─── Formulaire de soumission → Notion (côté serveur uniquement) ────────────
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ─── Réservation ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/dawoodijajo01

# ─── Analytics (optionnel) ──────────────────────────────────────────────────
# Domaine déclaré dans Plausible (ex. nexoradigital.com). Vide = aucun script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
